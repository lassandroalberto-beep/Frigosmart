# =============================================================================
# AVVIO: Scheduler e server
# =============================================================================

if __name__ == '__main__':
    # 1. Inizializziamo il database (crea le tabelle se non esistono)
    init_db()
    
    # 2. Avviamo lo scheduler per i controlli automatici delle scadenze
    #    BackgroundScheduler gira in un thread separato senza bloccare Flask
    scheduler = BackgroundScheduler()
    scheduler.add_job(
        func=controlla_e_notifica,
        trigger='cron',         # 'cron' = orario fisso, come il crontab di Linux
        hour=9,                 # Alle 9:00 di ogni mattina
        minute=0,
        id='controllo_scadenze'
    )
    scheduler.start()
    print("⏰ Scheduler avviato — controllo scadenze ogni mattina alle 9:00")
    
    # atexit assicura che lo scheduler venga fermato correttamente quando chiudi il server
    atexit.register(lambda: scheduler.shutdown())
    
    # 3. Avviamo il server Flask
    print(f"🚀 Server avviato su http://{HOST}:{PORT}")
    print(f"📱 Gli scanner devono puntare a: http://<IP-DEL-PC>:{PORT}/scan")
    app.run(host=HOST, port=PORT, debug=DEBUG)